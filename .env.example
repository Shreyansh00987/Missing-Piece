# Missing Piece Environment Configuration Template
# Copy this file to .env and configure keys if running proprietary APIs or authenticated Kaggle CLI.

# Kaggle API credentials (optional, for notebook submission and dataset upload)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Hugging Face Hub Token (optional, for higher rate limits or gated model access)
# HF_TOKEN=your_huggingface_token

# Proprietary LLM APIs (optional, if evaluating commercial endpoints)
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GEMINI_API_KEY=your_gemini_api_key
# GROQ_API_KEY=your_groq_api_key

# Benchmark Execution Settings
BENCHMARK_SEED=42
BENCHMARK_OUTPUT_DIR=outputs
BENCHMARK_CACHE_DIR=outputs/cache
LOG_LEVEL=INFO
